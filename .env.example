# Copy to .env (already in .gitignore) and edit. docker compose reads it automatically.

# Required. Use letters and digits only: the password goes into a connection URL.
SALE_READER_PASSWORD=change-me

# Required, and deliberately not set here: SALE_START and SALE_END, the sale window in ISO-8601.
# Without them the stack refuses to start. The README ("Build and run") shows how to set them.

# Optional, with these defaults
# SALE_ID=flash-sale-1
# TOTAL_STOCK=100
# POSTGRES_DB=flashsale
# POSTGRES_PASSWORD=postgres

# Optional tuning. Set RATE_LIMIT_IP_ENABLED=false for the stress test (see "Stress test" in the README).
# ADMIT_BATCH_SIZE=50
# ADMIT_INTERVAL_MS=2000
# ADMIT_WINDOW_MS=120000
# RATE_LIMIT_IP_ENABLED=true
